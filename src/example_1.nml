/***** PLATFORM LEFT *****/

spriteset (example_platform_left, "src/stations_1_empty.png") {
    [  10, 10, 64, 64, -32, -34 ]
    [  80, 10, 64, 64, -32, -34 ]
}

spriteset (example_platform_left_half, "src/stations_1_half.png") {
    [  10, 10, 64, 64, -32, -34 ]
    [  80, 10, 64, 64, -32, -34 ]
}

spriteset (example_platform_left_full, "src/stations_1_full.png") {
    [  10, 10, 64, 64, -32, -34 ]
    [  80, 10, 64, 64, -32, -34 ]
}

spritelayout platform_left_sw_ne(a) {
    ground {
        sprite: GROUNDSPRITE_RAIL_X;
    }
    building {
        sprite:         DEFAULT(0);
        xoffset:        0;
        yoffset:        1;
        zoffset:        0;
        xextent:        16;
        yextent:        5;
        zextent:        12;
        recolour_mode:  RECOLOUR_REMAP;
        palette:        PALETTE_USE_DEFAULT;
    }
}

spritelayout platform_left_se_nw(a) {
    ground {
        sprite: GROUNDSPRITE_RAIL_Y;
    }
    building {
        sprite:         DEFAULT(1);
        xoffset:        11;
        yoffset:        1;
        zoffset:        0;
        xextent:        5;
        yextent:        16;
        zextent:        12;
        recolour_mode:  RECOLOUR_REMAP;
        palette:        PALETTE_USE_DEFAULT;
    }
}

spritegroup group_platform_left {
    little: [example_platform_left, example_platform_left_half];
    lots:   example_platform_left_full;
}

item(FEAT_STATIONS, example_left) {
    property {
        class:                  "XMPL";
        classname:              string(STR_NAME_STATCLASS_SINGLE_PLATFORMS);
        name:                   string(STR_NAME_STATION_EXAMPLE_PLATFORM);
        cargo_threshold:        160;
    }
    graphics {
        sprite_layouts: [platform_left_sw_ne(0), platform_left_se_nw(0)];
        select_tile_type: 2;
        PASS: group_platform_left;
        purchase: example_platform_left;
        example_platform_left;
    }
}

