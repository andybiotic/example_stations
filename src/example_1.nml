/***** TWO TILE BUILDING EXAMPLE *****/
/* This is a building comprised of two unique tiles. */
/* First we must set the two tiles, and provide two orientations for each. */

spriteset (building_1, "src/stations_1_empty.png") {
    [ 10, 150, 64, 64, -32, -32 ]
    [ 80, 150, 64, 64, -32, -32 ]
}
spriteset (building_2, "src/stations_1_empty.png") {
    [ 150, 150, 64, 64, -32, -32 ]
    [ 220, 150, 64, 64, -32, -32 ]
}

/* Next we take the item (0) from the array for tile a */

spritelayout example_building_tile_a() {
    ground {
        sprite: GROUNDSPRITE_CONCRETE;
    }
    building {
        sprite:         DEFAULT(0);
        xoffset:        0;
        yoffset:        0;
        zoffset:        0;
        xextent:        16;
        yextent:        16;
        zextent:        20;
        recolour_mode:  RECOLOUR_REMAP;
        palette:        PALETTE_USE_DEFAULT;
    }
}

/* Then we use item (1) for tile b */

spritelayout example_building_tile_b() {
    ground {
        sprite: GROUNDSPRITE_CONCRETE;
    }
    building {
        sprite:         DEFAULT(1);
        xoffset:        0;
        yoffset:        0;
        zoffset:        0;
        xextent:        16;
        yextent:        16;
        zextent:        20;
        recolour_mode:  RECOLOUR_REMAP;
        palette:        PALETTE_USE_DEFAULT;
    }
}

/* We define a switch which will return either the first array, or the second. */
/* This will depend on the platform number of the current tile. */

switch (FEAT_STATIONS, SELF, switch_double_platform_constructor, platform_number_from_start(PLATFORM_SAME_SECTION)) {
    0: building_1;
    1: building_2;
}

/* Finally when defining the station object, we use the switch, rather than returning a static building spriteset. */
/* The tile_flags property here marks the tile as being without caternary and isn't possible for a train to transit. */

item(FEAT_STATIONS, example_building_1) {
    property {
        class:                  "BULD";
        classname:              string(STR_NAME_STATCLASS_EXAMPLE_BUILDING);
        name:                   string(STR_NAME_STATION_EXAMPLE_BUILDING);
        tile_flags: [
            bitmask(STAT_TILE_NOWIRE, STAT_TILE_BLOCKED),
            bitmask(STAT_TILE_NOWIRE, STAT_TILE_BLOCKED)
        ];
        disabled_platforms:     bitmask(1,3,4,5,6,7,8);
        disabled_length:        bitmask(2,3,4,5,6,7,8);
    }
    graphics {
        sprite_layouts:         [example_building_tile_a(), example_building_tile_b()];
        select_tile_type:       0;
        purchase:               building_1;
        switch_double_platform_constructor;
    }
}