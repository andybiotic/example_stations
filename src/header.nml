/* This section defines the grf metadata, including the grfid. */

grf {
    grfid: "XXX\01";
    name: string(STR_GRF_NAME);
    desc: string(STR_GRF_DESCRIPTION);
    version: 1;
    min_compatible_version: 1;
    param 1 {
        param_disable_unlock_year {
            type: bool;
            name: string(STR_PARAM_DISABLE_UNLOCK_YEAR_NAME);
            desc: string(STR_PARAM_DISABLE_UNLOCK_YEAR_DESCRIPTION);
        }
    }
}

if (version_openttd(1,2,0,22723) > openttd_version) {
    error(FATAL, REQUIRES_OPENTTD, string(STR_VERSION_22723));
}

cargotable {
    PASS
}

/* This switch us used to determine the availability of the tile in the station build window, depending on the current year */

switch (FEAT_STATIONS, SELF, switch_intro_year_example, current_year) {
  0..1929: param[1] ? 1 : 0;
  default: 1;
}

/* END OF SETUP */
